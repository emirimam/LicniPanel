# Kopiraj u .env pored ovog fajla. .env NE ide u git.

# --- Supabase ---
SUPABASE_URL=https://sgrxammnrdvrcoboxobz.supabase.co
# Service role kljuc: Supabase dashboard -> Project Settings -> API keys.
# Ovaj kljuc zaobilazi RLS. Nikad ga ne stavljaj u panel ni u browser.
SUPABASE_SERVICE_ROLE_KEY=

# Adresa kojom se prijavljujes u panel - worker po njoj nalazi tvog korisnika.
VLASNIK_EMAIL=emir@itdreamwire.com

# --- Model za klasifikaciju ---
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5

# --- Nalozi ---
# Dodaj ih koliko treba: NALOG_2_, NALOG_3_ ...
# PROSTOR je slug prostora u panelu: posao ili privatno.
NALOG_1_NAZIV=Startiti
NALOG_1_PROSTOR=privatno
NALOG_1_HOST=imap.gmail.com
NALOG_1_PORT=993
NALOG_1_KORISNIK=ugstartiti@gmail.com
NALOG_1_LOZINKA=
# Fascikle: INBOX uvijek; poslane navedi ako se zovu drugacije.
NALOG_1_POSLANE=[Gmail]/Sent Mail

# --- Podesavanja ---
# Koliko poruka povuci pri prvom pokretanju po nalogu.
PRVI_PUT_ZADNJIH=30
# Provjera kad IDLE veza padne, u sekundama.
INTERVAL_SEKUNDI=120
# Koliko dana cekamo odgovor prije nego poruka iskoci na ekran "Cekam odgovor".
ROK_ODGOVORA_DANA=3
