# Kopiraj u .env pored ovog fajla. .env NE ide u git.
#
# Mail nalozi se NE podesavaju ovdje nego u panelu, na stranici Nalozi.
# Lozinke stoje sifrovane u Supabase Vaultu; worker ih vadi preko servisnog
# kljuca, a panel ih poslije upisa ne moze procitati.

# --- Supabase ---
SUPABASE_URL=https://sgrxammnrdvrcoboxobz.supabase.co
# Project Settings -> API keys -> service_role. Zaobilazi RLS, drzi ga samo ovdje.
SUPABASE_SERVICE_ROLE_KEY=

# Adresa kojom se prijavljujes u panel.
VLASNIK_EMAIL=emir@itdreamwire.com

# --- Model za klasifikaciju ---
# Max, Ultra i Team planovi imaju mjesecne API kredite: claude.ai -> Settings ->
# Billing -> API credits -> Link organization. Kljuc se onda uzima u Konzoli.
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5

# --- Podesavanja ---
# Koliko poruka povuci pri prvom citanju fascikle.
PRVI_PUT_ZADNJIH=30
# Razmak izmedju provjera, u sekundama.
INTERVAL_SEKUNDI=120
# Koliko radnih dana cekamo odgovor prije nego prepiska iskoci na ekran.
ROK_ODGOVORA_DANA=3
